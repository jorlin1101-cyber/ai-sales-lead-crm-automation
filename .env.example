# Application mode: demo | rule_only | live
APP_MODE=demo
ALLOW_NETWORK=false

# LLM provider: openai | deepseek
LLM_PROVIDER=openai

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM reliability settings
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Offline demo feature fixtures
DEMO_FEATURE_FIXTURES_PATH=data/demo/lead_feature_fixtures.json

# RAG configuration
RAG_BACKEND=keyword
RAG_REQUIRED=true
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Knowledge files
KNOWLEDGE_CHUNKS_PATH=data/demo/knowledge_chunks.json
KNOWLEDGE_MANIFEST_PATH=config/knowledge_manifest.yml

# Notion maintenance scripts
NOTION_API_KEY=
NOTION_KNOWLEDGE_ROOT_PAGE_ID=
NOTION_PARENT_PAGE_ID=
