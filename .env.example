# Docker host port; the container always listens on port 8000
API_PORT=8000

# Application mode: demo | rule_only | live
APP_MODE=demo
ALLOW_NETWORK=false

# LLM provider: openai | deepseek
LLM_PROVIDER=openai

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM reliability settings
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Optional operator-only multi-turn understanding and evidence-bound replies via Qwen.
# Keep the key server-side. Public demo visitors never invoke this model.
CONVERSATION_LLM_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONVERSATION_LLM_TIMEOUT_SECONDS=30

# Offline demo feature fixtures
DEMO_FEATURE_FIXTURES_PATH=data/demo/lead_feature_fixtures.json

# RAG configuration: disabled | keyword_rrf | bge_rrf
RAG_BACKEND=keyword_rrf
RAG_REQUIRED=false
RAG_TOP_K=3
RAG_CANDIDATE_TOP_K=5
KNOWLEDGE_CHUNKS_PATH=data/knowledge_snapshot/knowledge_chunks.json
BGE_API_BASE_URL=http://127.0.0.1:8001/v1
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_TIMEOUT_SECONDS=60

# Optional live grounded recommendation; disabled by default
GROUNDED_RECOMMENDATION_ENABLED=false
RECOMMENDATION_MAX_OUTPUT_TOKENS=1024

# Knowledge maintenance files
KNOWLEDGE_MANIFEST_PATH=config/knowledge_manifest.yml

# Notion maintenance scripts
NOTION_API_KEY=
NOTION_KNOWLEDGE_ROOT_PAGE_ID=
NOTION_PARENT_PAGE_ID=

# Optional Notion CRM delivery. The token remains server-side and is never sent to the browser.
NOTION_CRM_ENABLED=false
NOTION_LEADS_DATA_SOURCE_ID=
NOTION_API_VERSION=2025-09-03
NOTION_TIMEOUT_SECONDS=15
NOTION_MAX_RETRIES=2

# P0 multi-turn conversation store. PostgreSQL is the operational source of truth.
CONVERSATION_DATABASE_URL=postgresql+psycopg://leadflow:leadflow@postgres:5432/leadflow
CONVERSATION_AUTO_CREATE_SCHEMA=false

# local: loopback operator only; public_demo: isolated offline visitors; protected: token required.
# Use protected or public_demo for a network-facing deployment, not local.
SERVICE_ACCESS_MODE=local
SERVICE_ACCESS_TOKEN=
# Set a stable random secret for demo cookies across restarts (server-side only).
SERVICE_SESSION_SECRET=
# Optional canonical-channel HMAC adapter. Empty disables /webhooks/inbound.
INBOUND_WEBHOOK_SECRET=
# Verified operator-owned price rules JSON; empty means no numeric quote is available.
PRICING_RULES_PATH=
