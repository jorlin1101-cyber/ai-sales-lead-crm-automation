# Docker host port; the container always listens on port 8000
API_PORT=8000

# Application mode: demo | rule_only | live
APP_MODE=demo
ALLOW_NETWORK=false

# LLM provider: openai | deepseek
LLM_PROVIDER=openai

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM reliability settings
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Offline demo feature fixtures
DEMO_FEATURE_FIXTURES_PATH=data/demo/lead_feature_fixtures.json

# RAG configuration: disabled | keyword_rrf | bge_rrf
RAG_BACKEND=keyword_rrf
RAG_REQUIRED=false
RAG_TOP_K=3
RAG_CANDIDATE_TOP_K=5
KNOWLEDGE_CHUNKS_PATH=data/knowledge_snapshot/knowledge_chunks.json
BGE_API_BASE_URL=http://127.0.0.1:8001/v1
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_TIMEOUT_SECONDS=60

# Optional live grounded recommendation; disabled by default
GROUNDED_RECOMMENDATION_ENABLED=false
RECOMMENDATION_MAX_OUTPUT_TOKENS=1024

# Knowledge maintenance files
KNOWLEDGE_MANIFEST_PATH=config/knowledge_manifest.yml

# Notion maintenance scripts
NOTION_API_KEY=
NOTION_KNOWLEDGE_ROOT_PAGE_ID=
NOTION_PARENT_PAGE_ID=
